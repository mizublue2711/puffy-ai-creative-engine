{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puffy.com/schemas/asset_registry.schema.json",
  "title": "Puffy Unified Asset Registry",
  "description": "Schema for the deduplicated, SHA-256 verified unified asset registry generated by scripts/sync_registry.mjs from assets/catalog/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "last_synced_at",
    "total_assets",
    "stats",
    "registry"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the asset registry format (e.g., \"1.0.0\")."
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "description": "ISO-8601 UTC timestamp of the most recent registry sync."
    },
    "total_assets": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of indexed canonical assets in registry."
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutout",
        "hero",
        "detail",
        "badge"
      ],
      "properties": {
        "cutout": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of assets with intent \"cutout\"."
        },
        "hero": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of assets with intent \"hero\"."
        },
        "detail": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of assets with intent \"detail\"."
        },
        "badge": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of assets with intent \"badge\"."
        }
      }
    },
    "registry": {
      "type": "object",
      "description": "Canonical asset map keyed by {category}/{product_slug}/{intent}_{variant}_{resolution}.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9\\-]+/[a-z0-9\\-]+/(cutout|hero|detail|badge)_[a-z0-9\\-]+_[a-z0-9\\-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "file_path",
            "sha256",
            "category",
            "product_slug",
            "intent",
            "variant",
            "resolution",
            "format",
            "source_origin",
            "pipeline_status",
            "tags"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9\\-]+/[a-z0-9\\-]+/(cutout|hero|detail|badge)_[a-z0-9\\-]+_[a-z0-9\\-]+$",
              "description": "Canonical asset identifier matching {category}/{product_slug}/{intent}_{variant}_{resolution}."
            },
            "file_path": {
              "type": "string",
              "pattern": "^assets/catalog/[a-z0-9\\-]+/[a-z0-9\\-]+/(cutout|hero|detail|badge)_[a-z0-9\\-]+_[a-z0-9\\-]+\\.(png|webp|svg|jpg)$",
              "description": "Repository-relative canonical path under assets/catalog/."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$",
              "description": "Hex-encoded SHA-256 hash of the physical asset file."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9\\-]+$",
              "description": "Canonical product or asset category (kebab-case)."
            },
            "product_slug": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9\\-]+$",
              "description": "Canonical product slug (kebab-case)."
            },
            "intent": {
              "type": "string",
              "enum": [
                "cutout",
                "hero",
                "detail",
                "badge"
              ],
              "description": "Creative asset intent classification."
            },
            "variant": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9\\-]+$",
              "description": "Asset variant token (kebab-case, no underscores)."
            },
            "resolution": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9\\-]+$",
              "description": "Asset resolution token (e.g., 1200x720 or vector)."
            },
            "format": {
              "type": "string",
              "enum": [
                "png",
                "webp",
                "svg",
                "jpg"
              ],
              "description": "Asset file extension/format."
            },
            "source_origin": {
              "type": "string",
              "minLength": 1,
              "description": "Origin pipeline or catalog source that produced this asset."
            },
            "pipeline_status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n8n_background_removed",
                "zero_product_drift_verified",
                "used_in_banner_engine",
                "used_in_remotion"
              ],
              "properties": {
                "n8n_background_removed": {
                  "type": "boolean",
                  "description": "Whether the asset passed through n8n background removal."
                },
                "zero_product_drift_verified": {
                  "type": "boolean",
                  "description": "Whether Zero Product Drift fidelity has been verified."
                },
                "used_in_banner_engine": {
                  "type": "boolean",
                  "description": "Whether the asset is actively referenced by pipelines/banner_engine/."
                },
                "used_in_remotion": {
                  "type": "boolean",
                  "description": "Whether the asset is actively referenced by pipelines/remotion/."
                }
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Searchable metadata tags for this asset."
            }
          }
        }
      }
    }
  }
}
