{
  "name": "puffy-ai-creative-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "webapp"
  ],
  "description": "Autonomous creative pipeline, brand design tokens, and Google Pomelli asset ingestion engine for Puffy®",
  "scripts": {
    "build": "npm --prefix webapp run build",
    "scrape:pomelli": "tsx scripts/scrape_pomelli.ts",
    "sync:github": "tsx scripts/sync_github.ts",
    "ingest:pomelli": "tsx scripts/scrape_pomelli.ts && tsx scripts/sync_github.ts",
    "typecheck": "tsc --noEmit",
    "prepreview": "npm run build",
    "audit": "bash scripts/deployment-audit.sh",
    "audit:secrets": "./scripts/secret-audit.sh all",
    "audit:secrets:staged": "./scripts/secret-audit.sh --staged",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
